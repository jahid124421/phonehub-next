# ─── PhoneHub environment ────────────────────────────────────────────────────
# Everything is OPTIONAL: the site runs with zero env vars
# (bundled JSON data + heuristic AI answers). Add keys to unlock more.

# Postgres connection string (Supabase/Prisma Postgres/etc.)
# Unlocks DB-backed API responses; JSON fallback is used when unset.
DATABASE_URL=

# AI providers for /api/answer (Groq is primary, Gemini is fallback).
# GROQ_API_KEY is free at https://console.groq.com
GROQ_API_KEY=
GEMINI_API_KEY=

# Shared daily cap on LLM invocations (cost ceiling). When spent, /api/answer
# degrades gracefully to the free local heuristic engine until the next UTC day.
# Default: 500
AI_DAILY_LLM_BUDGET=

# Protects /api/cron/daily and /api/revalidate. REQUIRED in production —
# generate with: openssl rand -hex 32
CRON_SECRET=

# Local dev ONLY: set to 1 to call cron endpoints without CRON_SECRET.
# Never set this in any deployed environment.
ALLOW_INSECURE_CRON=

# Error tracking (both optional, both zero-config):
# - SENTRY_DSN: forwards server errors to Sentry via the Envelope API
#   (no SDK needed). Format: https://<key>@<host>/<projectId>
# - ERROR_WEBHOOK_URL: Slack/Discord webhook for error alerts (server-only).
# - NEXT_PUBLIC_SENTRY_DSN: same DSN exposed to the browser so client-side
#   errors (error boundaries) are also reported. DSNs are public-by-design.
SENTRY_DSN=
ERROR_WEBHOOK_URL=
NEXT_PUBLIC_SENTRY_DSN=

# Amazon Product Advertising API 5.0 — real product prices & images (server-only).
# Create Associate account: https://affiliate-program.amazon.com/
# Then IAM user with PA-API permission. When unset, site still builds — /api/amazon
# returns a fallback https://www.amazon.com/s?k=... / /dp/... link.
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=
# Optional endpoint overrides (rarely needed):
# AMAZON_HOST=webservices.amazon.com
# AMAZON_REGION=us-east-1

# Canonical site URL (used for sitemap/OG/canonical tags).
NEXT_PUBLIC_SITE_URL=
